MAPBOX_TOKEN=sk.your-token-here
# Required by default: expose a restricted public pk token to the browser.
MAPBOX_PUBLIC_TOKEN=pk.your-public-token-here
# Set false only for API-only deployments that do not serve the map UI.
REQUIRE_MAPBOX_PUBLIC_TOKEN=true

# Optional when running `uv run python main.py`.
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Optional cost/abuse controls for the expensive meeting-point endpoint.
MAX_REQUEST_BODY_BYTES=64000
MAX_IN_FLIGHT_SEARCHES=4
MEETING_POINT_TIMEOUT_SECONDS=45
MEETING_POINT_RATE_LIMIT=30
MEETING_POINT_RATE_WINDOW_SECONDS=60
# Set true only when the app is behind a trusted proxy that controls X-Forwarded-For.
TRUST_PROXY_HEADERS=false
